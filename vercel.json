{
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/css/(.*)",    "dest": "/css/$1" },
    { "src": "/js/(.*)",     "dest": "/js/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/models/(.*)", "dest": "/models/$1" },
    { "src": "/(.*)",        "dest": "/api/index.js" }
  ]
}
